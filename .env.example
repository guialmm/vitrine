# Copy to .env and fill in. Values below work with docker compose out of the box,
# except the Stripe keys (use your *test mode* keys from dashboard.stripe.com/test/apikeys).
# API runs on :8001, frontend on :5174 (8000/5173 are often taken by other projects)
DATABASE_URL=postgresql+asyncpg://vitrine:vitrine@localhost:5432/vitrine
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5174

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Vitrine <no-reply@vitrine.dev>
